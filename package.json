{
  "name": "dsh-canvas",
  "version": "0.2.0",
  "private": true,
  "description": "给 DSH 加一个类 n8n / Dify 的可视化画布工作流：拖节点、连线、点运行、节点实时高亮。外壳自研，引擎用内核现成的 workflow 服务。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "canvas",
    "workflow",
    "n8n"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT"
}
